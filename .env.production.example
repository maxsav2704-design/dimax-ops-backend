APP_ENV=production
DIMAX_BACKEND_IMAGE=registry.example.com/dimax/backend:git-0123456789ab
DATABASE_URL=postgresql+psycopg2://dimax_app:replace-with-db-password@prod-db.example.com:5432/dimax?sslmode=require
JWT_SECRET=replace-with-random-64-character-secret-before-production
JWT_ISSUER=dimax
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# Used only by the one-shot production bootstrap service.
SEED_COMPANY_NAME=DIMAX GROUP
SEED_ADMIN_EMAIL=admin@dimax.example.com
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_ADMIN_FULL_NAME=Admin DIMAX

PUBLIC_BASE_URL=https://api.example.com
CORS_ALLOW_ORIGINS=https://ops.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
EMAIL_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_VALIDATE=false
TWILIO_WEBHOOK_AUTH_TOKEN=
# Empty disables the generic provider webhook. Set a random 32+ character token to enable it.
OUTBOX_WEBHOOK_TOKEN=
OUTBOX_DELIVERY_RISK_AUTO_ISSUE_ENABLED=true
OUTBOX_DELIVERY_RISK_MIN_FAILED=1
OUTBOX_DELIVERY_RISK_WINDOW_HOURS=72
WHATSAPP_ENABLED=false
WHATSAPP_FALLBACK_TO_EMAIL=false

MINIO_ENDPOINT=s3.example.com
MINIO_ACCESS_KEY=replace-with-storage-access-key
MINIO_SECRET_KEY=replace-with-storage-secret-key
MINIO_BUCKET=dimax
MINIO_SECURE=true
MINIO_PRESIGN_EXPIRY_SEC=86400
FILE_TOKEN_TTL_SEC=3600
FILE_TOKEN_USES=1
JOURNAL_PUBLIC_TOKEN_TTL_SEC=2592000

WAZE_BASE_URL=https://waze.com/ul
WAZE_NAVIGATION_ENABLED=true
